---
layout: layouts/main.njk
pagination:
  data: archive.byAlbum
  size: 1
  alias: album
eleventyComputed:
  title: "Publicaciones del álbum {{ album.posts[0].metadata.album | safe }}"
permalink: "/archive/albums/{{ album.slug }}.html"
pageClass: archive
---

{% set posts = album.posts %}
{% set meta = album.posts[0].metadata %}
{% set heading = "Publicaciones del álbum " + meta.album + (", de " + meta.artist if meta.artist else "") %}
{% set crumbLabel = meta.album %}
{% include "partials/archive-table.njk" %}
