---
layout: layouts/main.njk
pagination:
  data: collections.posts
  size: 1
  alias: post
eleventyComputed:
  title: "{{ post.title | safe }}"
permalink: "archive/{{ post.id }}.html"
---

{#- Linear navigation (below the post): the collection is in chronological order (oldest first).
    It lives outside .post-view: the sticky side column can travel to the end of .post-view and would overlap it. #}
{%- set prevPost = collections.posts[pagination.pageNumber - 1] if pagination.pageNumber > 0 %}
{%- set nextPost = collections.posts[pagination.pageNumber + 1] %}
{#- A previous/next card: the artist's Commons photo (archive.artistImages), or their initials, beside the
    label, title and author #}
{%- macro navCard(target, rel, label) %}
  {%- set photo = archive.artistImages[target.slugs.artist] if target.slugs.artist %}
  {%- set initial = archive.artistInitials[target.slugs.artist] if target.slugs.artist %}
  <a class="post-nav__link post-nav__link--{{ rel }}{% if photo or initial %} post-nav__link--image{% endif %}" href="/archive/{{ target.id }}.html" rel="{{ rel }}">
    {%- if photo or initial %}
    <span class="post-nav__photo" aria-hidden="true">
      {%- if initial %}<span class="display post-nav__initial">{{ initial }}</span>{% endif %}
      {%- if photo %}<img src="{{ photo.src }}" alt="" title="Foto: {{ photo.credit }}" loading="lazy" decoding="async" width="72" height="72" onerror="this.remove()">{% endif -%}
    </span>
    {%- endif %}
    <span class="post-nav__text">
      <span class="post-nav__label">{{ label }}</span>
      <span class="post-nav__title">{{ target.title }}</span>
      <span class="post-nav__editor">{{ target.editor.name }}</span>
    </span>
  </a>
{%- endmacro %}
{%- macro postNav(position, prevPost, nextPost) %}
<nav class="post-nav post-nav--{{ position }}" aria-label="Navegación entre artículos">
  {%- if prevPost %}
  {{ navCard(prevPost, "prev", "← Anterior") }}
  {%- endif %}
  <a class="post-nav__link post-nav__link--random" href="/rand/">
    <span class="post-nav__label">Al azar</span>
    <span class="post-nav__title">Sorpréndeme con cualquier artículo</span>
  </a>
  {%- if nextPost %}
  {{ navCard(nextPost, "next", "Siguiente →") }}
  {%- endif %}
</nav>
{%- endmacro %}

<div class="post-view">
  {#- Outside the header (it spans both columns); radio mode swaps it with the post -#}
  {%- set pubYear = post.published_at.slice(0, 4) %}
  <nav class="crumbs post-view__crumbs" aria-label="Migas">
    <a href="/archive/">Archivo</a>
    {%- if post.special %}<a href="/archive/especiales/">Especiales</a>{% for t in archive.specials %}{% if t.type == post.special.type %}<a href="/archive/especiales/#{{ t.type }}">{{ t.name }}</a>{% endif %}{% endfor %}
    {%- else %}<a href="/archive/all/?year={{ pubYear }}">{{ pubYear }}</a>{% endif -%}
    {#- The post's Nº between the previous and next posts (also at the foot: post-nav) #}
    <span class="crumbs__pager">
      {%- if prevPost %}<a href="/archive/{{ prevPost.id }}.html" rel="prev" title="Anterior" aria-label="Anterior">←</a>{% endif %}
      <span class="crumbs__number">Nº {{ pagination.pageNumber + 1 }}</span>
      {%- if nextPost %}<a href="/archive/{{ nextPost.id }}.html" rel="next" title="Siguiente" aria-label="Siguiente">→</a>{% endif -%}
    </span>
  </nav>

  <header class="post-view__header">
  {%- set special = post.special %}
  {%- set series = archive.series[special.series] if special and special.series %}
  {%- if special %}
  {%- set heading = { main: special.title, by: special.by } if special.type == "album" else { main: special.title } %}
  {#- Especiales: a black tag instead of the kicker; a festival day says where it is in its series -#}
  <span class="kicker special-tag">Especial · {{ special.label }}
    {%- if series %}{% for item in series %}{% if item.id == post.id %} · {{ loop.index }} de {{ series | length }}{% endif %}{% endfor %}{% endif -%}
  </span>
  {%- else %}
  {%- set heading = post.title | splitTitle %}
  {%- endif %}
  {%- if not special and (post.metadata.category or post.metadata.genre) %}
  <span class="kicker post-view__kicker">
    {%- if post.metadata.category %}{% if post.slugs.category %}<a href="/archive/categories/{{ post.slugs.category }}.html">{{ post.metadata.category }}</a>{% else %}{{ post.metadata.category }}{% endif %}{% endif %}
    {%- if post.metadata.category and post.metadata.genre %} · {% endif %}
    {%- if post.metadata.genre %}{{ post.metadata.genre }}{% endif -%}
  </span>
  {%- endif %}
  <h1 class="display post-view__title">{{ heading.main }}</h1>
  {%- if heading.by %}
  <p class="post-view__by">de {% if post.slugs.artist and (heading.by | lower) == (post.metadata.artist | lower) %}<a href="/archive/artists/{{ post.slugs.artist }}.html">{{ heading.by }}</a>{% else %}{{ heading.by }}{% endif %}
    {%- if special and special.type == "album" and post.metadata.year %} · {{ post.metadata.year }}{% endif %}</p>
  {%- endif %}

  <div class="post-view__meta">
    <span class="post-view__editor author">
      {%- set slug = post.slugs.editor %}{% include "partials/avatar.njk" %}
      {%- if post.editor.url %}
      <a href="{{ post.editor.url }}" target="_blank"><span class="post-view__editor-name">{{ post.editor.name }}</span></a>
      {%- else %}
      <span class="post-view__editor-name">{{ post.editor.name }}</span>
      {%- endif %}
    </span>
    <time class="post-view__date" datetime="{{ post.published_at | isoDate }}">{{ post.published_at | longDate(false, true) }}</time>
    <span>{{ post.content | readingTime }} min de lectura</span>
    {#- Local builds only (CI builds with ELEVENTY_ENV=production): opens the post in the local editor (npm run edit) -#}
    {%- if env.ELEVENTY_ENV != "production" %}
    <a class="post-view__edit" href="http://localhost:8082/#{{ post.id }}" target="dsong-editor">Editar</a>
    {%- endif %}
  </div>
  </header>

  <div class="post-view__content">
    {{ post.content | markdown | safe }}
  </div>

  {#- Players available for this post, in display order -#}
  {%- set m = post.metadata %}
  {%- set players = [] %}
  {%- if m.youtube_code %}{% set players = players.concat([{ id: "youtube", label: "YouTube", type: "video", src: "https://www.youtube.com/embed/" + m.youtube_code + "?enablejsapi=1", title: "Vídeo de YouTube" }]) %}{% endif %}
  {#- Spotify tracks are compact; albums, playlists and artists show their track list #}
  {%- if m.spotify_url %}{% set players = players.concat([{ id: "spotify", label: "Spotify", type: "iframe", src: m.spotify_url, height: (80 if "/track/" in m.spotify_url else 352), title: "Reproductor de Spotify" }]) %}{% endif %}
  {#- Apple song embeds (?i=<track>) are compact; album embeds show the tracklist #}
  {%- if m.apple_music_url %}{% set players = players.concat([{ id: "apple-music", label: "Apple Music", type: "iframe", src: m.apple_music_url, height: (175 if "?i=" in m.apple_music_url else 450), title: "Reproductor de Apple Music" }]) %}{% endif %}


  {#- Side column (sticky in the desktop split view, after the text on narrow screens): players, podcast, Ficha #}
  {%- set hasSide = (players | length) or m.podcast_file or (post.facts | length) or series %}
  {%- if hasSide %}<aside class="post-view__side">{% endif %}

  {%- if players | length %}
  {#- Radio mode (js/radio.js): plays the next posts' YouTube videos with their text; hidden without JS #}
  {%- set inRadio = archive.radioById[post.id] %}
  <div class="players">
    <div class="players__tabs" role="tablist" aria-label="Reproductores">
      {%- for player in players %}
      <button class="players__tab" type="button" role="tab" id="tab-{{ player.id }}" aria-controls="panel-{{ player.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ player.label }}</button>
      {%- endfor %}
    </div>

    {%- for player in players %}
    {#- Only the active panel loads its player; others keep the URL in data-src until shown #}
    {%- set srcAttr = ("src" if loop.first else "data-src") %}
    <div class="players__panel players__panel--{{ player.id }}" role="tabpanel" id="panel-{{ player.id }}" aria-labelledby="tab-{{ player.id }}"{% if not loop.first %} hidden{% endif %}>
      {%- if player.type == "audio" %}
      <audio controls preload="none" {{ srcAttr }}="{{ player.src }}">Tu navegador no soporta este tipo de reproductor</audio>
      {%- elif player.type == "video" %}
      <div class="post-view__media-container">
        <iframe title="{{ player.title }}" {{ srcAttr }}="{{ player.src }}" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
      {%- elif player.id == "apple-music" %}
      <iframe title="{{ player.title }}" {{ srcAttr }}="{{ player.src }}" width="100%" height="{{ player.height }}" frameborder="0" allow="autoplay *; encrypted-media *; clipboard-write" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation" style="max-width: 660px; overflow: hidden; border-radius: 10px;"></iframe>
      {%- else %}
      <iframe title="{{ player.title }}" {{ srcAttr }}="{{ player.src }}" width="100%" height="{{ player.height }}" frameborder="0" allowtransparency="true" allow="encrypted-media"></iframe>
      {%- endif %}
    </div>
    {%- endfor %}
    {%- if inRadio %}
    <button class="radio-toggle" type="button" hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M7 4l10 4"/><circle cx="15" cy="14" r="3"/></svg><span class="radio-toggle__label">Seguir en modo radio desde aquí</span></button>
    {%- endif %}
  </div>
  <script src="/js/players.js?v={{ 'js/players.js' | assetVersion }}" defer></script>
  {%- if inRadio %}
  <script src="/js/radio.js?v={{ 'js/radio.js' | assetVersion }}" defer></script>
  {%- endif %}
  {%- endif %}
  {#- UniRadio Jaén podcast: its own block, under the players #}
  {%- if m.podcast_file %}
  <section class="podcast" aria-labelledby="podcast-title">
    <div class="podcast__header">
      <a class="podcast__logo-link" href="https://uniradio.ujaen.es/" target="_blank"><img class="podcast__logo" src="/images/uniradio-jaen.jpg" alt="UniRadio Jaén"></a>
      <div>
        <span class="kicker">Podcast</span>
        <h3 class="podcast__title" id="podcast-title">Escúchalo en UniRadio Jaén</h3>
        <a class="podcast__feed" href="/podcast.xml">Suscríbete al podcast (RSS)</a>
      </div>
    </div>
    <audio class="podcast__audio" controls preload="metadata" src="https://dsongstatic.jesusmagamu.dev/mp3/podcast/{{ m.podcast_file }}">Tu navegador no soporta este tipo de reproductor</audio>
    {#- Own controls (js/podcast.js); without JS the native ones above stay #}
    <div class="podcast-player">
      <button class="podcast-player__play" type="button" aria-label="Reproducir" aria-pressed="false"><span class="podcast-player__icon" aria-hidden="true"></span></button>
      <input class="podcast-player__seek" type="range" min="0" max="0" step="1" value="0" aria-label="Posición del podcast">
      <span class="podcast-player__time"><span class="podcast-player__current">0:00</span> / <span class="podcast-player__duration">--:--</span></span>
      <button class="podcast-player__speed" type="button" aria-label="Velocidad de reproducción">1×</button>
    </div>
  </section>
  {%- endif %}

  {#- On every post: radio mode may bring in a podcast block from another post #}
  <script src="/js/podcast.js?v={{ 'js/podcast.js' | assetVersion }}" defer></script>
  <script src="/js/post-side.js?v={{ 'js/post-side.js' | assetVersion }}" defer></script>
  {#- Festival series: every day of it, this one marked; under the players, above the Ficha (radio mode swaps it) -#}
  {%- if series %}
  <nav class="series" aria-labelledby="series-title">
    <h2 class="kicker series__title" id="series-title">La serie · {{ special.series }}</h2>
    <ol class="series__list">
      {%- for item in series %}
      {%- set name = item.special.title.split(": ").slice(1).join(": ") or item.special.title %}
      <li class="series__item">
        <span class="series__meta">{{ item.published_at | weekDay }} · {{ item.editor.name }}</span>
        {%- if item.id == post.id %}
        <strong class="series__current" aria-current="page">{{ name }} · estás aquí</strong>
        {%- else %}
        <a href="/archive/{{ item.id }}.html">{{ name }}</a>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
    {%- if not (players | length) %}
    <p class="series__note">Este artículo no tiene reproductor: cada grupo suena en su artículo de la serie.</p>
    {%- endif %}
  </nav>
  {%- endif %}
  {#- Ficha (lib/facts.js): everything we know about the post, linked to the archive and its sources.
      In the side column, under the players; radio mode swaps it with the post. -#}
  {%- if post.facts | length %}
  <section class="post-facts" aria-labelledby="post-facts-title">
    <h2 class="kicker post-facts__title" id="post-facts-title">Ficha</h2>
    {#- Its groups (the music, then the post on dSong) without headings: a rule between them #}
    {%- for group in post.facts %}
    <dl class="post-facts__list" aria-label="{{ group.title }}">
      {%- for row in group.rows %}
      <dt>{{ row.label }}</dt>
      <dd>
        {%- for item in row.items %}
        {%- if item.musicbrainz %} <a class="post-facts__mb" href="{{ item.href }}" rel="noopener" target="_blank" title="Ver en {{ item.text }}"><svg class="post-facts__mb-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="8" r="2" fill="currentColor"/></svg>{{ item.text }}</a>
        {%- else %}
        {%- if not loop.first %}<span class="post-facts__sep"> · </span>{% endif %}
        {%- if item.href %}<a href="{{ item.href }}"{% if item.external %} rel="noopener" target="_blank"{% endif %}>{{ item.text }}{% if item.external %} ↗{% endif %}</a>{% else %}{{ item.text }}{% endif %}
        {%- if item.note %} <span class="post-facts__note">({{ item.note }})</span>{% endif %}
        {%- endif %}
        {%- endfor -%}
      </dd>
      {%- endfor %}
    </dl>
    {%- endfor %}
    <p class="post-facts__source">Datos de dSong, completados con <a href="https://musicbrainz.org/" rel="noopener" target="_blank">MusicBrainz ↗</a>.</p>
  </section>
  {%- endif %}
  {%- if hasSide %}
  </aside>
  {%- endif %}


  {% if post.comments and post.comments | length > 0 %}
    <details class="post-view__comments">
      <summary class="post-view__comments-summary">
        <svg class="post-view__comments-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>
        <span class="post-view__comments-text"><strong class="display">{{ post.comments | length }} {{ "comentario" if post.comments | length == 1 else "comentarios" }}</strong> en el blog original</span>
        <span class="post-view__comments-toggle" aria-hidden="true"><span class="post-view__comments-show">Ver</span><span class="post-view__comments-hide">Ocultar</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg></span>
      </summary>
      <ul>
        {% for comment in post.comments %}
          <li class="post-view__comment">
            <div class="post-view__comment-content">{{ comment.content }}</div>
            <div class="post-view__comment-meta">
              <span class="post-view__comment-editor">
                —
                {% if comment.author.url %}
                  <a href="{{ comment.author.url }}" target="_blank">
                    <span class="post-view__comment-editor-name">{{ comment.author.name }}</span>
                  </a>
                {% else %}
                  <span>
                    <span class="post-view__comment-editor-name">{{ comment.author.name }}</span>
                  </span>
                {% endif %}
              </span>
              <time class="post-view__comment-date" datetime="{{ comment.published_at | isoDate }}">{{ comment.published_at | longDate(true) }}</time>
            </div>
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
</div>

{{ postNav("bottom", prevPost, nextPost) }}
