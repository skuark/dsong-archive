---
layout: layouts/main.njk
title: Mapa musical
permalink: /mapa/
pageClass: map
---
{%- set countries = archive.byCountry | sort(true, false, "posts.length") %}

{%- set max = (countries | first).posts.length %}
<div class="page-head map-head">
  <div>
    <p class="kicker">Mapa musical</p>
    <h1 class="page-title">De dónde venía la música</h1>
  </div>
  <p class="map-intro">Cada país, coloreado por las recomendaciones de artistas de allí. Pulsa uno para ver sus artículos.</p>
</div>

<div class="map-layout">
<figure class="map">
  <svg class="map__svg" viewBox="0 0 {{ worldMap.width }} {{ worldMap.height }}" role="img" aria-labelledby="map-title">
    <title id="map-title">Mapa mundial con el número de publicaciones por país del artista</title>
    {%- for c in worldMap.countries %}
    {%- if c.slug %}
    <a href="/archive/countries/{{ c.slug }}.html"><path class="map__country map-level-{{ c.level }}" d="{{ c.d }}"><title>{{ c.name }}: {{ c.count }} {{ "publicación" if c.count == 1 else "publicaciones" }}</title></path></a>
    {%- else %}
    <path class="map__country" d="{{ c.d }}"/>
    {%- endif %}
    {%- endfor %}
    {%- for c in worldMap.dots %}
    <a href="/archive/countries/{{ c.slug }}.html"><circle class="map__country map__dot map-level-{{ c.level }}" cx="{{ c.x }}" cy="{{ c.y }}" r="4"><title>{{ c.name }}: {{ c.count }} {{ "publicación" if c.count == 1 else "publicaciones" }}</title></circle></a>
    {%- endfor %}
  </svg>
  <figcaption class="map__legend">
    <span class="kicker">Artículos</span>
    {%- for min in worldMap.levels %}
    <span class="map__legend-item"><span class="map__swatch map-level-{{ loop.index }}"></span>{{ min }}{% if loop.last %} o más{% else %}–{{ worldMap.levels[loop.index] - 1 }}{% endif %}</span>
    {%- endfor %}
  </figcaption>
</figure>

<aside class="map-top" aria-labelledby="map-top-title">
  <div class="map-top__head">
    <h2 class="display map-top__title" id="map-top-title">Los que más</h2>
    <span class="kicker">artículos</span>
  </div>
  <ol class="bars map-top__bars">
    {%- for country in countries.slice(0, 10) %}
    <li class="bars__row">
      <a class="bars__label" href="/archive/countries/{{ country.slug }}.html">{{ country.name }}</a>
      <span class="bars__track"><span class="bars__fill{% if loop.first %} bars__fill--top{% endif %}" style="width: {{ (country.posts.length / max * 100) | round(1) }}%"></span></span>
      <span class="bars__value">{{ country.posts.length }}</span>
    </li>
    {%- endfor %}
  </ol>
  <details class="bars-more">
    <summary>Todos los países · {{ countries | length }}</summary>
    <ol class="map-countries">
      {%- for country in countries %}
      <li><a href="/archive/countries/{{ country.slug }}.html">{{ country.name }}</a> <span class="map-countries__count">{{ country.posts.length }}</span></li>
      {%- endfor %}
    </ol>
  </details>
</aside>
</div>
