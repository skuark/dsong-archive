---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/archive/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/mapa/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/archive/all/</loc>
  </url>
  {%- for index in ["editors", "artists", "podcasts"] %}
  <url>
    <loc>{{ site.url }}/archive/{{ index }}/</loc>
  </url>
  {%- endfor %}
  {%- for post in collections.posts %}
  <url>
    <loc>{{ site.url }}/archive/{{ post.id }}.html</loc>
  </url>
  {%- endfor %}
  {%- for artist in archive.byArtist %}
  <url>
    <loc>{{ site.url }}/archive/artists/{{ artist.slug }}.html</loc>
  </url>
  {%- endfor %}
  {%- for album in archive.byAlbum %}
  <url>
    <loc>{{ site.url }}/archive/albums/{{ album.slug }}.html</loc>
  </url>
  {%- endfor %}
  {%- for editor in archive.byEditor %}
  <url>
    <loc>{{ site.url }}/archive/editors/{{ editor.slug }}.html</loc>
  </url>
  {%- endfor %}
  {%- for year in archive.byYear %}
  <url>
    <loc>{{ site.url }}/archive/years/{{ year.slug }}.html</loc>
  </url>
  {%- endfor %}
  {%- for country in archive.byCountry %}
  <url>
    <loc>{{ site.url }}/archive/countries/{{ country.slug }}.html</loc>
  </url>
  {%- endfor %}
  {%- for category in archive.byCategory %}
  <url>
    <loc>{{ site.url }}/archive/categories/{{ category.slug }}.html</loc>
  </url>
  {%- endfor %}
</urlset>
