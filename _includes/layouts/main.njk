<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set fullTitle = (title + " – " + site.title) if title else site.title %}
  {%- set description = (post.content | excerpt) or site.description %}
  {%- set canonical = site.url + page.url %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ description }}">
  {%- if noIndex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonical }}">
  <link rel="alternate" type="application/rss+xml" title="dSong en UniRadio Jaén (podcast)" href="/podcast.xml">
  {%- endif %}
  <meta property="og:type" content="{{ 'article' if post else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}/images/logo.png">
  <link rel="stylesheet" href="/css/bundle.css?v={{ 'css/bundle.css' | assetVersion }}">
  <link rel="icon" href="/images/favicon.png">
  <link rel="preload" href="/fonts/titillium-web-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/amaranth-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  {% if env.ELEVENTY_ENV == "production" %}
  <script defer src="https://cloud.umami.is/script.js" data-website-id="{{ site.umamiId }}"></script>
  {% else %}
  <!-- Umami analytics disabled in development -->
  {% endif %}
  {%- if post %}
  {%- if post.metadata.song and post.metadata.artist %}
  {%- set about = { "@type": "MusicRecording", "name": post.metadata.song, "byArtist": { "@type": "MusicGroup", "name": post.metadata.artist } } %}
  {%- endif %}
  {%- set jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "url": canonical,
    "datePublished": post.published_at | isoDate,
    "author": { "@type": "Person", "name": post.editor.name },
    "inLanguage": "es",
    "publisher": { "@type": "Organization", "name": site.title, "url": site.url },
    "about": about
  } %}
  {%- elif page.url == "/" %}
  {%- set jsonLd = { "@context": "https://schema.org", "@type": "WebSite", "name": site.title, "url": site.url + "/", "inLanguage": "es", "description": site.description } %}
  {%- endif %}
  {%- if jsonLd %}
  <script type="application/ld+json">{{ jsonLd | dump | safe }}</script>
  {%- endif %}
</head>
<body>

  <div class="app page-{{ pageClass }}">
    <div class="app-wrapper">
      <header class="header">
        <a class="header__logo" href="/">
          <span class="header__logo-name">dSong</span>
          <span class="header__logo-headline">El archivo · 2009–2017</span>
        </a>

        <nav class="header__nav" aria-label="Principal">
          <ul class="header__menu">
            <li class="header__menu--item"><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Inicio</a></li>
            <li class="header__menu--item"><a href="/archive/"{% if page.url.startsWith("/archive") and not page.url.startsWith("/archive/podcasts") %} aria-current="page"{% endif %}>Archivo</a></li>
            <li class="header__menu--item"><a href="/mapa/"{% if page.url == "/mapa/" %} aria-current="page"{% endif %}>Mapa</a></li>
            <li class="header__menu--item"><a href="/archive/podcasts/"{% if page.url.startsWith("/archive/podcasts") %} aria-current="page"{% endif %}>Podcast</a></li>
            <li class="header__menu--item"><a href="/radio/">Radio</a></li>
          </ul>
          <form class="header__search" role="search" action="/archive/all/">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <label class="visually-hidden" for="header-search">Buscar en el archivo</label>
            <input class="header__search-input" id="header-search" type="search" name="q" placeholder="Artista, canción…">
          </form>
        </nav>
      </header>

      {{ content | safe }}

      <footer class="footer">
        <p><a href="/el-proyecto/">El proyecto</a> · Contenidos bajo licencia <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/es/" target="_blank">CC BY-NC-SA 3.0 ES</a></p>
        <p>¿Una errata o un reproductor roto? <a href="mailto:dsong@jesusmagamu.dev">Escríbenos</a> o <a href="https://github.com/skuark/dsong-archive" target="_blank">abre una issue</a></p>
      </footer>
    </div>
  </div>
</body>
</html>
