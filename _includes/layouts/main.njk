<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set fullTitle = (title + " – " + site.title) if title else site.title %}
  {%- set description = (post.content | excerpt) or site.description %}
  {%- set canonical = site.url + page.url %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ description }}">
  {%- if noIndex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonical }}">
  {%- endif %}
  <meta property="og:type" content="{{ 'article' if post else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}/images/logo.png">
  <link rel="stylesheet" href="/css/bundle.css?v={{ 'css/bundle.css' | assetVersion }}">
  <link rel="icon" href="/images/favicon.png">
  <link rel="preload" href="/fonts/titillium-web-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/amaranth-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  {% if env.ELEVENTY_ENV == "production" %}
  <script defer src="https://cloud.umami.is/script.js" data-website-id="{{ site.umamiId }}"></script>
  {% else %}
  <!-- Umami analytics disabled in development -->
  {% endif %}
  {%- if post %}
  {%- if post.metadata.song and post.metadata.artist %}
  {%- set about = { "@type": "MusicRecording", "name": post.metadata.song, "byArtist": { "@type": "MusicGroup", "name": post.metadata.artist } } %}
  {%- endif %}
  {%- set jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "url": canonical,
    "datePublished": post.published_at | isoDate,
    "author": { "@type": "Person", "name": post.editor.name },
    "inLanguage": "es",
    "publisher": { "@type": "Organization", "name": site.title, "url": site.url },
    "about": about
  } %}
  {%- elif page.url == "/" %}
  {%- set jsonLd = { "@context": "https://schema.org", "@type": "WebSite", "name": site.title, "url": site.url + "/", "inLanguage": "es", "description": site.description } %}
  {%- endif %}
  {%- if jsonLd %}
  <script type="application/ld+json">{{ jsonLd | dump | safe }}</script>
  {%- endif %}
</head>
<body>
  <a href="https://github.com/skuark/dsong-archive" target="_blank" class="github-corner" aria-label="Ver código fuente en GitHub"><svg width="80" height="80" viewBox="0 0 250 250" style="fill:#151513; color:#fff; position: absolute; top: 0; border: 0; right: 0;" aria-hidden="true"><path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path><path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin: 130px 106px;" class="octo-arm"></path><path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor" class="octo-body"></path></svg></a>

  <div class="app page-{{ pageClass }}">
    <div class="app-wrapper">
      <div class="header">
        <div class="header__logo-container">
          <a href="/"><img src="/images/logo.png" class="header__logo" alt="dSong"></a>
          <div class="header__logo-headline">{{ site.title }}</div>
        </div>

        <ul class="header__menu">
          <li class="header__menu--item"><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Inicio</a></li>
          <li class="header__menu--item"><a href="/archive/"{% if page.url.startsWith("/archive") %} aria-current="page"{% endif %}>Archivo</a></li>
          <li class="header__menu--item"><a href="/rand/"><img src="/images/dices.png" alt="Dados" class="header__menu--dices"> Voy a tener suerte</a></li>
        </ul>
      </div>

      {{ content | safe }}

      <footer class="footer">
        <p>🎧 <a href="/">dSong</a>: una recomendación musical diaria entre 2009 y 2017. Cerca de 2.000 artículos y 335 podcasts con <a href="https://uniradio.ujaen.es/" target="_blank">UniRadio Jaén</a>.</p>
        <p>🤝 Contenidos bajo licencia <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/es/" target="_blank">CC BY-NC-SA 3.0 ES</a>.</p>
        <p>📨 ¿Una errata o un reproductor que no funciona? <a href="mailto:dsong@jesusmagamu.dev">Escríbenos</a> o <a href="https://github.com/skuark/dsong-archive" target="_blank">abre una issue en GitHub</a>.</p>
      </footer>
    </div>
  </div>
</body>
</html>
