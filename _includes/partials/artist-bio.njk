{#- Short bio and photo of the artist (data/artist-bios.json: Wikipedia + a Wikimedia Commons image, hotlinked with its credit) -#}
<section class="artist-bio{% if not artistBio.image %} artist-bio--text{% endif %}" aria-label="Sobre el artista">
  {%- if artistBio.image %}
  <figure class="artist-bio__photo">
    <img src="{{ artistBio.image.src }}" width="{{ artistBio.image.width }}" height="{{ artistBio.image.height }}" alt="{{ artist.name }}" loading="lazy" decoding="async">
    <figcaption><a href="{{ artistBio.image.page }}" rel="noopener">{{ artistBio.image.author or "Wikimedia Commons" }}{% if artistBio.image.license %} · {{ artistBio.image.license }}{% endif %}</a></figcaption>
  </figure>
  {%- endif %}
  {%- if artistBio.bio %}
  <div class="artist-bio__text">
    <p{% if artistBio.lang != "es" %} lang="{{ artistBio.lang }}"{% endif %}>{{ artistBio.bio }}</p>
    <p class="artist-bio__source"><a href="{{ artistBio.wikipedia }}" rel="noopener">Wikipedia{% if artistBio.lang != "es" %} (en inglés){% endif %} ↗</a></p>
  </div>
  {%- endif %}
</section>
