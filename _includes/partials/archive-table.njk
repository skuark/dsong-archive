{#- Variables: posts, heading, crumbs ([{ url, label }] between "Archivo" and the heading), headingLinks,
    yearChips (publication-year select, js/archive-table-search.js) -#}
<nav class="crumbs" aria-label="Migas">
  <a href="/archive/">Archivo</a>
  {%- for crumb in crumbs %}<a href="{{ crumb.url }}">{{ crumb.label }}</a>{% endfor %}
  <span>{{ crumbLabel or heading }}</span>
</nav>
{%- if heading %}
<div class="page-head">
  <h1 class="page-title">{{ heading }}</h1>
</div>
{%- endif %}
{%- if headingLinks %}
<p class="archive-links">{% for link in headingLinks %}<a href="{{ link.url }}" rel="noopener">{{ link.label }} ↗</a>{% endfor %}</p>
{%- endif %}

<div class="archive-search archive-search--table">
  {#- One box: the text filter and, joined to it, the publication-year select (js/archive-table-search.js) #}
  <div class="archive-search__bar">
    <label class="visually-hidden" for="archive-search">Buscar</label>
    <input class="archive-search__input" id="archive-search" type="search" placeholder="Canción, artista, álbum, autor…" autocomplete="off">
    {%- if yearChips %}
    <label class="archive-search__year">
      <span class="archive-search__year-label">Año</span>
      <select class="archive-search__year-select" id="archive-year">
        <option value="">Todos</option>
        {%- for item in stats.byYear %}
        <option value="{{ item.name }}"><span class="archive-search__option-year">{{ item.name }}</span> <span class="archive-search__option-count">({{ item.count }})</span></option>
        {%- endfor %}
      </select>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </label>
    {%- endif %}
  </div>
  <span class="archive-search__count" id="archive-search-count" aria-live="polite">{{ posts | length }} {{ "publicación" if (posts | length) == 1 else "publicaciones" }}</span>
</div>

<div class="archive">
  <table class="archive-table" id="archive-table">
    <thead>
      <tr>
        <th class="archive-table__cell--published-at sortable" data-sort="date" data-col="0">Fecha <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--title sortable" data-sort="string" data-col="1">Publicación <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--song sortable" data-sort="string" data-col="2">Canción <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--artist sortable" data-sort="string" data-col="3">Artista <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--album sortable" data-sort="string" data-col="4">Álbum <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--year sortable" data-sort="number" data-col="5">Año <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--category sortable" data-sort="string" data-col="6">Categoría <span class="sort-indicator"></span></th>
        <th class="archive-table__cell--editor sortable" data-sort="string" data-col="7">Autor <span class="sort-indicator"></span></th>
      </tr>
    </thead>
    <tbody>
      {%- for post in posts -%}
      <tr>
        <td class="archive-table__cell--published-at" data-value="{{ post.published_at }}">{{ post.published_at | formatDate("dd/MM/yyyy") }}</td>
        <td class="archive-table__cell--title"><a href="/archive/{{ post.id }}.html">{{ post.title }}</a></td>
        <td class="archive-table__cell--song">{{ post.metadata.song }}</td>
        <td class="archive-table__cell--artist">{% if post.slugs.artist %}<a href="/archive/artists/{{ post.slugs.artist }}.html">{{ post.metadata.artist }}</a>{% endif %}</td>
        <td class="archive-table__cell--album">{% if post.slugs.album %}<a href="/archive/albums/{{ post.slugs.album }}.html">{{ post.metadata.album }}</a>{% endif %}</td>
        <td class="archive-table__cell--year">{% if post.slugs.year %}<a href="/archive/years/{{ post.slugs.year }}.html">{{ post.metadata.year }}</a>{% endif %}</td>
        <td class="archive-table__cell--category">{% if post.slugs.category %}<a href="/archive/categories/{{ post.slugs.category }}.html">{{ post.metadata.category }}</a>{% endif %}</td>
        <td class="archive-table__cell--editor">{% if post.slugs.editor %}<a href="/archive/editors/{{ post.slugs.editor }}.html">{{ post.editor.name }}</a>{% endif %}</td>
      </tr>
      {%- endfor -%}
    </tbody>
  </table>
  <p class="archive__empty" id="archive-search-empty" hidden>Nada por aquí. Prueba con otro nombre o <a href="/rand/">un artículo al azar</a>.</p>
</div>

<script src="/js/archive-table-search.js?v={{ 'js/archive-table-search.js' | assetVersion }}"></script>
<script src="/js/archive-table-sort.js?v={{ 'js/archive-table-sort.js' | assetVersion }}"></script>
